# ── 전역 (경로 무관) ──────────────────────────────────────
*.o
*.log
*_dbg.wasm

*.mo
*.pyc
__pycache__/
**/.DS_Store
**/CMakeLists.txt.autosave
CMakeLists.txt.user
.idea/
/.vscode/
.vs/*
.clangd
/.cache/
*.code-workspace
.init_bundle.ini
node_modules/

# 도구 디렉토리 (세션/플러그인)
.omc/
.fablize/
.claude/
.playwright-mcp/
.env/

# ── web/ (데모 앱) + packages/ (npm 워크스페이스) ─────────
web/**/dist/
web/**/*.gcode
web/**/*.tsbuildinfo
packages/**/dist/
packages/**/*.gcode
packages/**/*.tsbuildinfo

# ── 커널 개발 부산물 (저장소에 넣지 않는다) ──────────────────
# 단계별 검증 스크린샷: 문서에 경로만 인용되는 증적이라 소스 저장소에 둘 이유가 없다(6.6MB).
packages/wasm-core/*.png
packages/wasm-core/screenshots/
# 테스트용 emscripten 산출물: build.sh 로 재생성 가능한 빌드 결과물(6.5MB).
#  배포되는 커널(packages/engine/src/slicer_core*.js)은 예외로 계속 추적한다.
packages/wasm-core/**/test_*.wasm
packages/wasm-core/**/test_*.js
# 일회성 조사/재현 스크립트 (회귀 스위트가 아님)
packages/wasm-core/repro_*.mjs
packages/wasm-core/compare_*.mjs

# 참조용 원본 클론 (독립 저장소)
slicer/
