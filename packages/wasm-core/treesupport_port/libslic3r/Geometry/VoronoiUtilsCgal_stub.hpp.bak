// STUB (stage 7 Arachne port): the real VoronoiUtilsCgal uses CGAL (huge, link-heavy, not ported)
// only to VERIFY the Voronoi diagram is planar and, if not, trigger a repair. Returning true
// ("planar, no repair needed") skips the CGAL repair path in Geometry/Voronoi.cpp::construct_voronoi.
// Trade-off: the rare non-planar-Voronoi robustness repair is disabled; normal inputs are unaffected.
#pragma once
#include <boost/polygon/polygon.hpp>
#include <iterator>
#include "Voronoi.hpp"
#include "../Arachne/utils/PolygonsSegmentIndex.hpp"

namespace Slic3r::Geometry {
class VoronoiDiagram;

class VoronoiUtilsCgal
{
public:
    static bool is_voronoi_diagram_planar_intersection(const VoronoiDiagram &) { return true; }

    template<typename SegmentIterator>
    static typename boost::polygon::enable_if<
        typename boost::polygon::gtl_if<typename boost::polygon::is_segment_concept<
            typename boost::polygon::geometry_concept<typename std::iterator_traits<SegmentIterator>::value_type>::type>::type>::type,
        bool>::type
    is_voronoi_diagram_planar_angle(const VoronoiDiagram &, SegmentIterator, SegmentIterator) { return true; }
};
} // namespace Slic3r::Geometry
