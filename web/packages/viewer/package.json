    "./loaders": "./dist/model_loaders.js",
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@three-slicer/engine": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": "^0.160.0"
  },
